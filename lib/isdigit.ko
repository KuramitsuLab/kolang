```pylike
# isdigit(s): 空でなく、すべて数字 0〜9（s.isdigit()。ASCII だけ）
def isdigit(s):
    if len(s) == 0:
        return False
    tmp1 = 0
    for _ in range(len(s)):
        c = s[tmp1]
        o = ord(c)
        tmp2 = False
        if o < 48:
            tmp2 = True
        else:
            if o > 57:
                tmp2 = True
        if tmp2 == True:
            return False
        tmp1 += 1
    return True
```
