>>> slice([0, 1, 2, 3, 4], 1, None, None)
[1, 2, 3, 4]
>>> slice([0, 1, 2, 3, 4], None, 2, None)
[0, 1]
>>> slice([0, 1, 2, 3, 4], 1, 3, None)
[1, 2]
>>> slice([0, 1, 2, 3, 4], None, None, -1)
[4, 3, 2, 1, 0]
>>> slice("hello", 1, None, 2)
"el"
>>> slice([0, 1, 2, 3, 4], -2, None, None)
[3, 4]
>>> slice("hello", None, -1, None)
"hell"
>>> slice("hello", 10, None, None)
""
>>> slice("hello", 3, 0, -1)
"lle"
>>> slice("", None, None, None)
""
>>> slice([0, 1, 2, 3, 4, 5], None, None, 2)
[0, 2, 4]
>>> slice("abcdef", -1, -4, -1)
"fed"
