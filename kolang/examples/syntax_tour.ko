```pylike
# 構文の一巡: doctest 以外の構文を 1 つずつ使う（pylike）。
# kolang には演算子も while もない。計算は標準ライブラリの関数、繰り返しは for _ in range(n) と break で書く。

# --- 値（式）---
n = 42                 # 数（符号なしの整数）
pi = 3.14              # 小数
s1 = "こんにちは"      # 文字列（"..." と '...' が使える）
s2 = 'it works'
yes = True
no = False
nothing = None
minus = -7             # 符号の反転は neg（Num は非負）
xs = [1, 2, 3]
empty = []
nested = [[1, 2], [3, 4]]
words = ["a", "b"]

# --- 名前 ---
# 英数字と _ は、そのまま名前にできる（先頭は英字、_ は途中だけ）。
snake_case = 1

# --- 代入・添字 ---
first = xs[0]
cell = nested[1][0]          # 添字は重ねられる
xs[1] = 20                   # 要素への代入
nested[0][1] = 99

# --- 追加・増やす・減らす ---
xs.append(4)
count = 0
count += 1                   # += 1 だけ（増やす）
count -= 1                   # -= 1 だけ（減らす）

# --- 条件（比較は 6 種類。if の条件にだけ書ける）---
if n == 42:
    print("eq")
if n != 0:
    print("ne")
if n < 100:
    print("lt")
if n > 1:
    print("gt")
if n <= 42:
    print("le")
if n >= 42:
    print("ge")

# --- if / else（else if はないので、入れ子にする）---
if n < 10:
    print("small")
else:
    if n < 100:
        print("medium")
    else:
        print("large")

# --- 繰り返し: n 回くり返す。n は式 ---
for _ in range(3):
    count += 1
for _ in range(len(xs)):
    _合計_ += 1

# --- break: 条件つきの無限ループの代わり ---
i = 0
for _ in range(1000):
    if i == 5:
        break
    i += 1

# --- 関数定義・return・呼び出し ---
def double(x):
    return mul(x, 2)

def greet(name):
    print(add("hello, ", name))      # return のない関数は None を返す

def sum_to(limit):
    total = 0
    k = 0
    for _ in range(limit):
        k += 1
        total = add(total, k)
    return total

def first_negative(ys):
    # return は、くり返しの中からも関数を抜ける
    j = 0
    for _ in range(len(ys)):
        if ys[j] < 0:
            return ys[j]
        j += 1
    return None

def add_pair(a, b):                  # 引数は複数
    return add(a, b)

def no_args():                       # 引数なし
    return 1

# 関数の中で別の関数を呼ぶ・再帰する
def fact(m):
    if m <= 1:
        return 1
    return mul(m, fact(sub(m, 1)))

# --- 呼び出しは式としても、文（戻り値は捨てる）としても書ける ---
greet("kolang")
print(double(21))
print(sum_to(10))
print(first_negative([3, 1, -4, 1]))
print(add_pair(add_pair(1, 2), double(3)))     # 引数に呼び出しを入れ子にする
print(no_args())
print(fact(5))
```

### 標準ライブラリの一巡

値も演算も Python のものなので、結果は Python と同じ。

```pylike

# --- 出力 ---
print("print は何個でも引数にできる", 1, True, None)

# --- 四則演算・剰余・べき乗（演算子はなく、関数で書く）---
add(1, 2)            # 3
sub(10, 4)           # 6
mul(6, 7)            # 42
div(7, 2)            # 3.5（真の除算。整数にしたいときは int で包む）
mod(17, 5)           # 2
pow(2, 10)           # 1024
int(div(7, 2))       # 3（切り捨て）

# add は文字列・リストの連結にも使える
add("ko", "lang")    # kolang
add([1, 2], [3])     # [1, 2, 3]

# --- 型の変換 ---
int("123")           # 123
float("1.5")         # 1.5
str(3.5)             # 3.5（文字列）
bool(0)              # False
bool([1])            # True
list("abc")          # ['a', 'b', 'c']
list(range(4))       # [0, 1, 2, 3]

# --- 数 ---
abs(-5)              # 5
round(3.14159, 2)    # 3.14
round(7.6)           # 8
max(3, 9, 4)         # 9
min([3, 9, 4])       # 3
sum([1, 2, 3, 4])    # 10

# --- 長さ・範囲・並べ替え ---
len("kolang")        # 6
len([1, 2, 3])       # 3

# --- 文字コード ---
ord("A")             # 65
chr(97)              # a
chr(add(ord("a"), 1))  # b（次の文字）

# --- 組み合わせの例: 平均を小数 1 桁で ---
def average(xs):
    return round(div(sum(xs), len(xs)), 1)

average([1, 2, 3, 4])    # 2.5
```
