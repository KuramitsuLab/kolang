{
  "name": "kobun",
  "description": "古文帳。平安のかな文学ふうの日本語（歴史的仮名遣い・終止形・連体形）。ブロックは ここより 〜 ここまで。名前は英数字。",
  "layout": "none",
  "toplevel": "bare",
  "space": "[ 　\\t\\r\\n]+",
  "word_segment": "[A-Za-z0-9_]",
  "tokens": {
    "comment": { "begin": "なほ、", "end": "(?=\\n)|\\Z" },
    "block": { "begin": "ここより", "begin.emit": " ここより", "sep": "", "sep.emit": " ", "end": "ここまで" },
    "assign": { "begin": "", "op": "を", "end": "とす", "order": "target_first" },
    "append": { "begin": "", "sep": "を", "end": "にくはふ", "order": "value_first" },
    "inc": { "begin": "", "end": "をます" },
    "dec": { "begin": "", "end": "をへらす" },
    "if": { "begin": "もし", "then": "ときは", "end": "" },
    "ne": { "begin": "", "sep": "が", "end": "にひとしからざる" },
    "lt": { "begin": "", "sep": "が", "end": "よりちひさき" },
    "gt": { "begin": "", "sep": "が", "end": "よりおほき" },
    "le": { "begin": "", "sep": "が", "end": "よりおほからざる" },
    "ge": { "begin": "", "sep": "が", "end": "よりちひさからざる" },
    "eq": { "begin": "", "sep": "が", "end": "にひとしき" },
    "else": { "begin": "さらずは", "end": "" },
    "repeat": { "begin": "", "do": "たびくりかへす", "end": "" },
    "break": "やむ",
    "def": { "begin": "わざ", "begin.emit": "わざ ", "name_end": "\\(", "end": "" },
    "params": { "begin": "", "end": "\\)とは" },
    "param": { "sep": ",|(?=\\))", "sep.emit": ", " },
    "return": { "begin": "", "end": "をかへす" },
    "true": "まこと",
    "false": "いつはり",
    "none": "なし",
    "list": { "begin": "\\[", "sep": ",|(?=\\])", "sep.emit": ", ", "end": "\\]" },
    "grouping": { "begin": "\\(", "end": "\\)" },
    "neg": { "begin": "-", "end": "" },
    "index": { "begin": "のうち\\(", "end": "\\)ばんめ" },
    "funcapp": { "order": "args_first", "begin": "\\(", "name_end": "\\)をもちゐる", "end": "のあたひ", "arg_sep": ",|(?=\\))", "arg_sep.emit": ", " }
  },
  "stdlib": {
    "print": "しめす",
    "abs": "ぜつたいち",
    "bool": "しんぎ",
    "chr": "もじ",
    "float": "せうすう",
    "int": "せいすう",
    "len": "ながさ",
    "list": "ならべ",
    "max": "もつともおほき",
    "min": "もつともちひさき",
    "ord": "しるしのかず",
    "range": "はんゐ",
    "round": "まるむ",
    "sorted": "ととのふ",
    "sum": "あはす",
    "add": "たす",
    "sub": "ひく",
    "mul": "かく",
    "div": "わる",
    "mod": "あまり",
    "pow": "かさぬ"
  },
  "lexical": {
    "letters": "[A-Za-z][A-Za-z0-9]*(?:_[A-Za-z0-9]+)*",
    "number": "[0-9]+(?:\\.[0-9]+)?",
    "string": "\"(?:[^\"\\\\\\n]|\\\\.)*\"|'(?:[^'\\\\\\n]|\\\\.)*'",
    "quote": { "begin": "_", "end": "_" },
    "characters": "[^_\\n]+"
  }
}
