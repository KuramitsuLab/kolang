{
  "name": "pslike",
  "description": "PostScript 風シンタックス。後置記法（値が先、命令が後）。ブロックは { }、名前の定義は /x 1 def。",
  "layout": "none",
  "toplevel": "bare",
  "index": "postfix",
  "space": "[ \\t\\r\\n]+",
  "tight_before": "[\\}\\]]",
  "word_segment": "[A-Za-z0-9_]",
  "reserved": ["def", "inc", "dec", "append", "if", "ifelse", "repeat", "exit", "return", "exec", "get", "neg", "mark", "ne", "lt", "gt", "le", "ge", "eq", "true", "false", "null"],
  "stdlib": {
    "print": "print",
    "add": "add",
    "sub": "sub",
    "mul": "mul",
    "div": "div",
    "mod": "mod",
    "pow": "pow",
    "int": "int",
    "str": "str",
    "float": "float",
    "bool": "bool"
  },
  "tokens": {
    "comment": { "begin": "%", "end": "(?=\\n)|\\Z" },
    "block": { "begin": "\\{", "sep": "", "sep.emit": " ", "end": "\\}" },
    "assign": { "begin": "/", "op": "", "op.emit": " ", "end": "def" , "end.emit": " def"},
    "append": { "begin": "", "sep": "", "sep.emit": " ", "end": "append", "end.emit": " append" },
    "inc": { "begin": "/", "end": "inc", "end.emit": " inc" },
    "dec": { "begin": "/", "end": "dec", "end.emit": " dec" },
    "if": { "begin": "", "then": "", "then.emit": " ", "end": "if(?!else)|", "end.emit": " if" },
    "ne": { "begin": "", "sep": "", "sep.emit": " ", "end": "ne", "end.emit": " ne" },
    "lt": { "begin": "", "sep": "", "sep.emit": " ", "end": "lt", "end.emit": " lt" },
    "gt": { "begin": "", "sep": "", "sep.emit": " ", "end": "gt", "end.emit": " gt" },
    "le": { "begin": "", "sep": "", "sep.emit": " ", "end": "le", "end.emit": " le" },
    "ge": { "begin": "", "sep": "", "sep.emit": " ", "end": "ge", "end.emit": " ge" },
    "eq": { "begin": "", "sep": "", "sep.emit": " ", "end": "eq", "end.emit": " eq" },
    "else": { "begin": "", "begin.emit": " ", "end": "ifelse", "end.emit": " ifelse" },
    "repeat": { "begin": "", "do": "", "do.emit": " ", "end": "repeat", "end.emit": " repeat" },
    "break": "exit",
    "def": { "begin": "/", "name_end": "", "name_end.emit": " ", "end": "def", "end.emit": " def" },
    "params": { "begin": "\\[", "end": "\\]", "end.emit": "] " },
    "param": { "sep": "", "sep.emit": " " },
    "return": { "begin": "", "end": "return", "end.emit": " return" },
    "true": "true",
    "false": "false",
    "none": "null",
    "neg": { "begin": "", "end": "neg", "end.emit": " neg" },
    "list": { "begin": "\\[", "sep": "", "sep.emit": " ", "end": "\\]" },
    "index": { "begin": "", "end": "get", "end.emit": " get" },
    "funcapp": { "order": "args_first", "begin": "mark", "begin.emit": "mark ", "name_end": "/", "name_end.emit": " /", "end": "exec", "end.emit": " exec", "arg_sep": "", "arg_sep.emit": " " }
  },
  "lexical": {
    "letters": "[A-Za-z][A-Za-z0-9]*(?:_[A-Za-z0-9]+)*",
    "number": "[0-9]+(?:\\.[0-9]+)?",
    "string": "\"(?:[^\"\\\\\\n]|\\\\.)*\"|'(?:[^'\\\\\\n]|\\\\.)*'",
    "quote": { "begin": "_", "end": "_" },
    "characters": "[^_\\n]+"
  }
}
