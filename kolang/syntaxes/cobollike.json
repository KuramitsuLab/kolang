{
  "name": "cobollike",
  "description": "COBOL 風。大文字の英語、文はピリオドで終える。`MOVE 1 TO X.`、`IF B IS EQUAL TO 0 THEN … END-IF.`、`PERFORM 3 TIMES … END-PERFORM.`、`DEFINE F USING A, B. … END-DEFINE.`。",
  "layout": "none",
  "toplevel": "bare",
  "space": "[ \\t\\r\\n]+",
  "word_segment": "[A-Za-z0-9_]",
  "tight_before": "[.)\\]]",
  "stdlib": {
    "print": "DISPLAY",
    "abs": "ABS",
    "bool": "BOOLEAN",
    "chr": "CHAR",
    "float": "FLOAT",
    "int": "INTEGER",
    "len": "LENGTH",
    "list": "LIST",
    "max": "MAX",
    "min": "MIN",
    "ord": "ORD",
    "range": "RANGE",
    "round": "ROUND",
    "sorted": "SORTED",
    "str": "STRING",
    "sum": "SUM",
    "add": "ADD",
    "sub": "SUBTRACT",
    "mul": "MULTIPLY",
    "div": "DIVIDE",
    "mod": "MOD",
    "pow": "POWER"
  },
  "tokens": {
    "comment": { "begin": "\\*>", "end": "(?=\\n)|\\Z" },
    "block": { "begin": "", "begin.emit": " ", "sep": "\\.", "sep.emit": ".", "end": "" },
    "assign": { "begin": "MOVE", "begin.emit": "MOVE ", "op": "TO", "op.emit": " TO ", "end": "", "order": "value_first" },
    "append": { "begin": "APPEND", "begin.emit": "APPEND ", "sep": "TO", "sep.emit": " TO ", "end": "", "order": "value_first" },
    "inc": { "begin": "ADD +1 +TO", "begin.emit": "ADD 1 TO ", "end": "" },
    "dec": { "begin": "SUBTRACT +1 +FROM", "begin.emit": "SUBTRACT 1 FROM ", "end": "" },
    "if": { "begin": "IF", "begin.emit": "IF ", "then": "THEN", "then.emit": " THEN", "end": "END-IF" },
    "ne": { "begin": "", "sep": "IS +NOT +EQUAL +TO", "sep.emit": " IS NOT EQUAL TO ", "end": "" },
    "lt": { "begin": "", "sep": "IS +LESS +THAN(?! +OR)", "sep.emit": " IS LESS THAN ", "end": "" },
    "gt": { "begin": "", "sep": "IS +GREATER +THAN(?! +OR)", "sep.emit": " IS GREATER THAN ", "end": "" },
    "le": { "begin": "", "sep": "IS +LESS +THAN +OR +EQUAL +TO", "sep.emit": " IS LESS THAN OR EQUAL TO ", "end": "" },
    "ge": { "begin": "", "sep": "IS +GREATER +THAN +OR +EQUAL +TO", "sep.emit": " IS GREATER THAN OR EQUAL TO ", "end": "" },
    "eq": { "begin": "", "sep": "IS +EQUAL +TO", "sep.emit": " IS EQUAL TO ", "end": "" },
    "else": { "begin": "ELSE", "end": "" },
    "repeat": { "begin": "PERFORM", "begin.emit": "PERFORM ", "do": "TIMES", "do.emit": " TIMES", "end": "END-PERFORM" },
    "break": "EXIT +PERFORM", "break.emit": "EXIT PERFORM",
    "def": { "begin": "DEFINE", "begin.emit": "DEFINE ", "name_end": "USING", "name_end.emit": " USING ", "end": "END-DEFINE" },
    "params": { "begin": "", "end": "\\." },
    "param": { "sep": ",|(?=\\.)", "sep.emit": ", " },
    "return": { "begin": "RETURN", "begin.emit": "RETURN ", "end": "" },
    "true": "TRUE",
    "false": "FALSE",
    "none": "NULL",
    "list": { "begin": "\\[", "sep": ",|(?=\\])", "sep.emit": ", ", "end": "\\]" },
    "neg": { "begin": "-", "end": "" },
    "index": { "begin": "\\(", "end": "\\)" },
    "funcapp": { "begin": "FUNCTION", "begin.emit": "FUNCTION ", "name_end": "\\(", "end": "\\)", "arg_sep": ",|(?=\\))", "arg_sep.emit": ", " }
  },
  "lexical": {
    "letters": "[A-Za-z][A-Za-z0-9]*(?:_[A-Za-z0-9]+)*",
    "number": "[0-9]+(?:\\.[0-9]+)?",
    "string": "\"(?:[^\"\\\\\\n]|\\\\.)*\"|'(?:[^'\\\\\\n]|\\\\.)*'",
    "quote": { "begin": "_", "end": "_" },
    "characters": "[^_\\n]+"
  }
}
