{
  "name": "enlike",
  "description": "英語版。ブロックはインデント。`set x to 1`、`if x is less than 3:`、`repeat 3 times:`、`define f(a, b):`。",
  "layout": "indent",
  "space": " +",
  "word_segment": "[A-Za-z0-9_]",
  "stdlib": {
    "print": "print",
    "abs": "absolute",
    "bool": "boolean",
    "chr": "character",
    "float": "float",
    "int": "integer",
    "len": "length",
    "list": "list",
    "max": "maximum",
    "min": "minimum",
    "ord": "ordinal",
    "range": "range",
    "round": "round",
    "sorted": "sorted",
    "str": "to_text",
    "sum": "sum",
    "add": "add",
    "sub": "subtract",
    "mul": "times_of",
    "div": "divide",
    "mod": "modulo",
    "pow": "power"
  },
  "tokens": {
    "comment": { "begin": "note:", "end": "(?=\\n)|\\Z" },
    "block": { "begin": "@INDENT", "sep": "@NEWLINE", "end": "@DEDENT" },
    "assign": { "begin": "set", "begin.emit": "set ", "op": "to", "op.emit": " to ", "end": "" },
    "append": { "begin": "append", "begin.emit": "append ", "sep": "to", "sep.emit": " to ", "end": "", "order": "value_first" },
    "inc": { "begin": "increase", "begin.emit": "increase ", "end": "" },
    "dec": { "begin": "decrease", "begin.emit": "decrease ", "end": "" },
    "if": { "begin": "if", "begin.emit": "if ", "then": ":", "end": "" },
    "ne": { "begin": "", "sep": "is +not +equal +to", "sep.emit": " is not equal to ", "end": "" },
    "lt": { "begin": "", "sep": "is +less +than", "sep.emit": " is less than ", "end": "" },
    "gt": { "begin": "", "sep": "is +greater +than", "sep.emit": " is greater than ", "end": "" },
    "le": { "begin": "", "sep": "is +at +most", "sep.emit": " is at most ", "end": "" },
    "ge": { "begin": "", "sep": "is +at +least", "sep.emit": " is at least ", "end": "" },
    "eq": { "begin": "", "sep": "is +equal +to", "sep.emit": " is equal to ", "end": "" },
    "else": { "begin": "else *:", "end": "" },
    "repeat": { "begin": "repeat", "begin.emit": "repeat ", "do": "times *:", "do.emit": " times:", "end": "" },
    "break": "break",
    "def": { "begin": "define", "begin.emit": "define ", "name_end": "\\(", "end": "" },
    "params": { "begin": "", "end": "\\) *:" },
    "param": { "sep": ",|(?=\\))", "sep.emit": ", " },
    "return": { "begin": "return", "begin.emit": "return ", "end": "" },
    "true": "true",
    "false": "false",
    "none": "none",
    "list": { "begin": "\\[", "sep": ",|(?=\\])", "sep.emit": ", ", "end": "\\]" },
    "neg": { "begin": "-", "end": "" },
    "index": { "begin": "\\[", "end": "\\]" },
    "funcapp": { "begin": "", "name_end": "\\(", "end": "\\)", "arg_sep": ",|(?=\\))", "arg_sep.emit": ", " }
  },
  "lexical": {
    "letters": "[A-Za-z][A-Za-z0-9]*(?:_[A-Za-z0-9]+)*",
    "number": "[0-9]+(?:\\.[0-9]+)?",
    "string": "\"(?:[^\"\\\\\\n]|\\\\.)*\"|'(?:[^'\\\\\\n]|\\\\.)*'",
    "quote": { "begin": "_", "end": "_" },
    "characters": "[^_\\n]+"
  }
}
