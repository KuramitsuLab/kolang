{
  "name": "jslike",
  "description": "JavaScript 風シンタックス。ブロックは { } 、文の終わりは ; 。",
  "layout": "none",
  "toplevel": "bare",
  "space": "[ \\t\\r\\n]+",
  "word_segment": "[A-Za-z0-9_$]",
  "tight_before": "[;)\\]]",
  "stdlib": {
    "print": "print",
    "add": "add",
    "sub": "sub",
    "mul": "mul",
    "div": "div",
    "mod": "mod",
    "pow": "pow",
    "int": "int",
    "str": "str",
    "float": "float",
    "bool": "bool"
  },
  "tokens": {
    "comment": { "begin": "//", "end": "(?=\\n)|\\Z" },
    "block": { "begin": "\\{", "sep": ";?", "sep.emit": ";", "end": "\\}" },
    "assign": { "begin": "", "op": "=(?!=)", "op.emit": " = ", "end": "" },
    "append": { "begin": "", "sep": "\\.push\\(", "end": "\\)" },
    "inc": { "begin": "", "end": "\\+\\+" },
    "dec": { "begin": "", "end": "--" },
    "if": { "begin": "if *\\(", "begin.emit": "if (", "then": "\\)", "then.emit": ") ", "end": "" },
    "ne": { "begin": "", "sep": "!==?", "sep.emit": " !== ", "end": "" },
    "lt": { "begin": "", "sep": "<(?!=)", "sep.emit": " < ", "end": "" },
    "gt": { "begin": "", "sep": ">(?!=)", "sep.emit": " > ", "end": "" },
    "le": { "begin": "", "sep": "<=", "sep.emit": " <= ", "end": "" },
    "ge": { "begin": "", "sep": ">=", "sep.emit": " >= ", "end": "" },
    "eq": { "begin": "", "sep": "===?", "sep.emit": " === ", "end": "" },
    "else": { "begin": "else", "begin.emit": " else ", "end": "" },
    "repeat": { "begin": "for *\\(let +_ *= *0 *; *_ *< *", "begin.emit": "for (let _ = 0; _ < ", "do": "; *_\\+\\+ *\\)", "do.emit": "; _++) ", "end": "" },
    "break": "break",
    "def": { "begin": "function", "begin.emit": "function ", "name_end": "\\(", "end": "" },
    "params": { "begin": "", "end": "\\)", "end.emit": ") " },
    "param": { "sep": ",|(?=\\))", "sep.emit": ", " },
    "return": { "begin": "return", "begin.emit": "return ", "end": "" },
    "true": "true",
    "false": "false",
    "none": "null",
    "list": { "begin": "\\[", "sep": ",|(?=\\])", "sep.emit": ", ", "end": "\\]" },
    "neg": { "begin": "-", "end": "" },
    "index": { "begin": "\\[", "end": "\\]" },
    "funcapp": { "begin": "", "name_end": "\\(", "end": "\\)", "arg_sep": ",|(?=\\))", "arg_sep.emit": ", " }
  },
  "lexical": {
    "letters": "[A-Za-z][A-Za-z0-9]*(?:_[A-Za-z0-9]+)*",
    "number": "[0-9]+(?:\\.[0-9]+)?",
    "string": "\"(?:[^\"\\\\\\n]|\\\\.)*\"|'(?:[^'\\\\\\n]|\\\\.)*'",
    "quote": { "begin": "_", "end": "_" },
    "characters": "[^_\\n]+"
  }
}
