{
  "name": "pylike",
  "description": "Python 風シンタックス。ブロックはインデントで表す。",
  "layout": "indent",
  "space": " +",
  "word_segment": "[A-Za-z0-9_]",
  "stdlib": {
    "print": "print",
    "add": "add",
    "sub": "sub",
    "mul": "mul",
    "div": "div",
    "mod": "mod",
    "pow": "pow",
    "int": "int",
    "str": "str",
    "float": "float",
    "bool": "bool"
  },
  "tokens": {
    "comment": { "begin": "#", "end": "(?=\\n)|\\Z" },
    "block": { "begin": "@INDENT", "sep": "@NEWLINE", "end": "@DEDENT" },
    "assign": { "begin": "", "op": "=(?!=)", "op.emit": " = ", "end": "" },
    "append": { "begin": "", "sep": "\\.append\\(", "end": "\\)" },
    "inc": { "begin": "", "end": "\\+= *1(?![0-9.])", "end.emit": " += 1" },
    "dec": { "begin": "", "end": "-= *1(?![0-9.])", "end.emit": " -= 1" },
    "if": { "begin": "if", "begin.emit": "if ", "then": ":", "end": "" },
    "ne": { "begin": "", "sep": "!=", "sep.emit": " != ", "end": "" },
    "lt": { "begin": "", "sep": "<(?!=)", "sep.emit": " < ", "end": "" },
    "gt": { "begin": "", "sep": ">(?!=)", "sep.emit": " > ", "end": "" },
    "le": { "begin": "", "sep": "<=", "sep.emit": " <= ", "end": "" },
    "ge": { "begin": "", "sep": ">=", "sep.emit": " >= ", "end": "" },
    "eq": { "begin": "", "sep": "==", "sep.emit": " == ", "end": "" },
    "else": { "begin": "else *:", "end": "" },
    "repeat": { "begin": "for +_ +in +range\\(", "do": "\\) *:", "end": "" },
    "break": "break",
    "def": { "begin": "def", "begin.emit": "def ", "name_end": "\\(", "end": "" },
    "params": { "begin": "", "end": "\\) *:" },
    "param": { "sep": ",|(?=\\))", "sep.emit": ", " },
    "return": { "begin": "return", "begin.emit": "return ", "end": "" },
    "true": "True",
    "false": "False",
    "none": "None",
    "list": { "begin": "\\[", "sep": ",|(?=\\])", "sep.emit": ", ", "end": "\\]" },
    "neg": { "begin": "-", "end": "" },
    "index": { "begin": "\\[", "end": "\\]" },
    "funcapp": { "begin": "", "name_end": "\\(", "end": "\\)", "arg_sep": ",|(?=\\))", "arg_sep.emit": ", " }
  },
  "lexical": {
    "letters": "[A-Za-z][A-Za-z0-9]*(?:_[A-Za-z0-9]+)*",
    "number": "[0-9]+(?:\\.[0-9]+)?",
    "string": "\"(?:[^\"\\\\\\n]|\\\\.)*\"|'(?:[^'\\\\\\n]|\\\\.)*'",
    "quote": { "begin": "_", "end": "_" },
    "characters": "[^_\\n]+"
  }
}
