{
  "name": "mathlike",
  "description": "数学記号版。キーワードと標準関数名はすべて記号（アルファベットなし）。名前（変数・自作の関数）だけ英数字。ブロックはインデント。`x ← 1`、`⊢ x < 3 ⇒`、`⟳ 3 ⇒`、`≝ f(a, b) ⇒`。",
  "layout": "indent",
  "space": " +",
  "word_segment": "[A-Za-z0-9_]",
  "stdlib": {
    "print": "⎙",
    "abs": "‖",
    "bool": "𝔹",
    "chr": "↤",
    "float": "ℝ",
    "int": "ℤ",
    "len": "#",
    "list": "☰",
    "max": "⊔",
    "min": "⊓",
    "ord": "↦",
    "range": "…",
    "round": "≈",
    "sorted": "⇅",
    "str": "“",
    "sum": "∑",
    "add": "+",
    "sub": "∸",
    "mul": "×",
    "div": "÷",
    "mod": "%",
    "pow": "^"
  },
  "tokens": {
    "comment": { "begin": "⍝", "end": "(?=\\n)|\\Z" },
    "block": { "begin": "@INDENT", "sep": "@NEWLINE", "end": "@DEDENT" },
    "assign": { "begin": "", "op": "←", "op.emit": " ← ", "end": "" },
    "append": { "begin": "", "sep": "⊞", "sep.emit": " ⊞ ", "end": "" },
    "inc": { "begin": "", "end": "↑", "end.emit": " ↑" },
    "dec": { "begin": "", "end": "↓", "end.emit": " ↓" },
    "if": { "begin": "⊢", "begin.emit": "⊢ ", "then": "⇒", "then.emit": " ⇒", "end": "" },
    "ne": { "begin": "", "sep": "≠", "sep.emit": " ≠ ", "end": "" },
    "lt": { "begin": "", "sep": "<", "sep.emit": " < ", "end": "" },
    "gt": { "begin": "", "sep": ">", "sep.emit": " > ", "end": "" },
    "le": { "begin": "", "sep": "≤", "sep.emit": " ≤ ", "end": "" },
    "ge": { "begin": "", "sep": "≥", "sep.emit": " ≥ ", "end": "" },
    "eq": { "begin": "", "sep": "=", "sep.emit": " = ", "end": "" },
    "else": { "begin": "⊬ *⇒", "begin.emit": "⊬ ⇒", "end": "" },
    "repeat": { "begin": "⟳", "begin.emit": "⟳ ", "do": "⇒", "do.emit": " ⇒", "end": "" },
    "break": "⊠",
    "def": { "begin": "≝", "begin.emit": "≝ ", "name_end": "\\(", "end": "" },
    "params": { "begin": "", "end": "\\) *⇒", "end.emit": ") ⇒" },
    "param": { "sep": ",|(?=\\))", "sep.emit": ", " },
    "return": { "begin": "↩", "begin.emit": "↩ ", "end": "" },
    "true": "⊤",
    "false": "⊥",
    "none": "∅",
    "list": { "begin": "\\[", "sep": ",|(?=\\])", "sep.emit": ", ", "end": "\\]" },
    "neg": { "begin": "−", "end": "" },
    "index": { "begin": "\\[", "end": "\\]" },
    "funcapp": { "begin": "", "name_end": "\\(", "end": "\\)", "arg_sep": ",|(?=\\))", "arg_sep.emit": ", " }
  },
  "lexical": {
    "letters": "[A-Za-z][A-Za-z0-9]*(?:_[A-Za-z0-9]+)*",
    "number": "[0-9]+(?:\\.[0-9]+)?",
    "string": "\"(?:[^\"\\\\\\n]|\\\\.)*\"|'(?:[^'\\\\\\n]|\\\\.)*'",
    "quote": { "begin": "_", "end": "_" },
    "characters": "[^_\\n]+"
  }
}
