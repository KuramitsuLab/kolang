{
  "name": "lisplike",
  "description": "Lisp 風シンタックス。S 式で書く。ブロックは括弧の中の文の並び。",
  "layout": "none",
  "index": "prefix",
  "space": "[ \\t\\r\\n]+",
  "word_segment": "[A-Za-z0-9_]",
  "tight_before": "\\)",
  "reserved": ["set", "append", "inc", "dec", "if", "else", "repeat", "break", "def", "return", "list", "get", "neg"],
  "stdlib": {
    "print": "print",
    "add": "add",
    "sub": "sub",
    "mul": "mul",
    "div": "div",
    "mod": "mod",
    "pow": "pow",
    "int": "int",
    "str": "str",
    "float": "float",
    "bool": "bool",
    "list": "to_list"
  },
  "tokens": {
    "comment": { "begin": ";", "end": "(?=\\n)|\\Z" },
    "block": { "begin": "", "sep": "", "sep.emit": " ", "end": "" },
    "assign": { "begin": "\\(set", "begin.emit": "(set ", "op": "", "op.emit": " ", "end": "\\)" },
    "append": { "begin": "\\(append", "begin.emit": "(append ", "sep": "", "sep.emit": " ", "end": "\\)" },
    "inc": { "begin": "\\(inc", "begin.emit": "(inc ", "end": "\\)" },
    "dec": { "begin": "\\(dec", "begin.emit": "(dec ", "end": "\\)" },
    "if": { "begin": "\\(if", "begin.emit": "(if ", "then": "", "then.emit": " ", "end": "\\)" },
    "ne": { "begin": "\\(!=", "begin.emit": "(!= ", "sep": "", "sep.emit": " ", "end": "\\)" },
    "lt": { "begin": "\\(<(?!=)", "begin.emit": "(< ", "sep": "", "sep.emit": " ", "end": "\\)" },
    "gt": { "begin": "\\(>(?!=)", "begin.emit": "(> ", "sep": "", "sep.emit": " ", "end": "\\)" },
    "le": { "begin": "\\(<=", "begin.emit": "(<= ", "sep": "", "sep.emit": " ", "end": "\\)" },
    "ge": { "begin": "\\(>=", "begin.emit": "(>= ", "sep": "", "sep.emit": " ", "end": "\\)" },
    "eq": { "begin": "\\(==", "begin.emit": "(== ", "sep": "", "sep.emit": " ", "end": "\\)" },
    "else": { "begin": "\\(else", "begin.emit": "(else ", "end": "\\)" },
    "repeat": { "begin": "\\(repeat", "begin.emit": "(repeat ", "do": "", "do.emit": " ", "end": "\\)" },
    "break": "\\(break\\)",
    "def": { "begin": "\\(def", "begin.emit": "(def ", "name_end": "", "name_end.emit": " ", "end": "\\)" },
    "params": { "begin": "\\(", "end": "\\)", "end.emit": ") " },
    "param": { "sep": "", "sep.emit": " " },
    "return": { "begin": "\\(return", "begin.emit": "(return ", "end": "\\)" },
    "true": "true",
    "false": "false",
    "none": "nil",
    "neg": { "begin": "\\(neg", "begin.emit": "(neg ", "end": "\\)" },
    "list": { "begin": "\\(list", "begin.emit": "(list ", "sep": "", "sep.emit": " ", "end": "\\)" },
    "index": { "begin": "\\(get", "begin.emit": "(get ", "sep": "", "sep.emit": " ", "end": "\\)" },
    "funcapp": { "begin": "\\(", "name_end": "", "name_end.emit": " ", "end": "\\)", "arg_sep": "", "arg_sep.emit": " " }
  },
  "lexical": {
    "letters": "[A-Za-z][A-Za-z0-9]*(?:_[A-Za-z0-9]+)*",
    "number": "[0-9]+(?:\\.[0-9]+)?",
    "string": "\"(?:[^\"\\\\\\n]|\\\\.)*\"|'(?:[^'\\\\\\n]|\\\\.)*'",
    "quote": { "begin": "_", "end": "_" },
    "characters": "[^_\\n]+"
  }
}
