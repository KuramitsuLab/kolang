{
  "name": "manyo",
  "description": "万葉仮名。古事記・万葉集のように、日本語の音を漢字（音仮名）で一音ずつ書く。語は kobun（古文帳）と同じで、名前は英数字。",
  "layout": "none",
  "toplevel": "bare",
  "space": "[ 　\\t\\r\\n]+",
  "word_segment": "[A-Za-z0-9_]",
  "tokens": {
    "comment": { "begin": "那保", "end": "(?=\\n)|\\Z" },
    "block": { "begin": "己許与理", "begin.emit": " 己許与理", "sep": "", "sep.emit": " ", "end": "己許麻弖" },
    "assign": { "begin": "", "op": "袁", "end": "登須", "order": "target_first" },
    "append": { "begin": "", "sep": "袁", "end": "迩久波布", "order": "value_first" },
    "inc": { "begin": "", "end": "袁麻須" },
    "dec": { "begin": "", "end": "袁弊良須" },
    "if": { "begin": "毛斯", "then": "登岐波", "end": "" },
    "ne": { "begin": "", "sep": "賀", "end": "迩比登斯迦良受" },
    "lt": { "begin": "", "sep": "賀", "end": "与理知比佐岐" },
    "gt": { "begin": "", "sep": "賀", "end": "与理意富岐" },
    "le": { "begin": "", "sep": "賀", "end": "与理意富迦良受" },
    "ge": { "begin": "", "sep": "賀", "end": "与理知比佐迦良受" },
    "eq": { "begin": "", "sep": "賀", "end": "迩比登斯岐" },
    "else": { "begin": "佐良受波", "end": "" },
    "repeat": { "begin": "", "do": "多備久理迦弊須", "end": "" },
    "break": "夜牟",
    "def": { "begin": "和邪", "begin.emit": "和邪 ", "name_end": "\\(", "end": "" },
    "params": { "begin": "", "end": "\\)登波" },
    "param": { "sep": ",|(?=\\))", "sep.emit": ", " },
    "return": { "begin": "", "end": "袁迦弊須" },
    "true": "麻許登",
    "false": "伊都波理",
    "none": "那斯",
    "list": { "begin": "\\[", "sep": ",|(?=\\])", "sep.emit": ", ", "end": "\\]" },
    "grouping": { "begin": "\\(", "end": "\\)" },
    "neg": { "begin": "-", "end": "" },
    "index": { "begin": "能宇知\\(", "end": "\\)婆牟米" },
    "funcapp": { "order": "args_first", "begin": "\\(", "name_end": "\\)袁毛知韋流", "end": "能阿多比", "arg_sep": ",|(?=\\))", "arg_sep.emit": ", " }
  },
  "stdlib": {
    "print": "斯米須",
    "abs": "是都多比知",
    "bool": "斯無疑",
    "chr": "毛士",
    "float": "勢宇須宇",
    "int": "勢伊須宇",
    "len": "那賀佐",
    "list": "那良弊",
    "max": "毛都登毛意富岐",
    "min": "毛都登毛知比佐岐",
    "ord": "斯流斯能賀受",
    "range": "波無韋",
    "round": "麻流牟",
    "sorted": "登登能布",
    "sum": "阿波須",
    "add": "多須",
    "sub": "比久",
    "mul": "迦久",
    "div": "和流",
    "mod": "阿麻理",
    "pow": "迦佐奴"
  },
  "lexical": {
    "letters": "[A-Za-z][A-Za-z0-9]*(?:_[A-Za-z0-9]+)*",
    "number": "[0-9]+(?:\\.[0-9]+)?",
    "string": "\"(?:[^\"\\\\\\n]|\\\\.)*\"|'(?:[^'\\\\\\n]|\\\\.)*'",
    "quote": { "begin": "_", "end": "_" },
    "characters": "[^_\\n]+"
  }
}
