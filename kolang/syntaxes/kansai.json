{
  "name": "kansai",
  "description": "関西弁。ブロックは ほな 〜 おしまい。名前は英数字。",
  "layout": "none",
  "toplevel": "bare",
  "space": "[ 　\\t\\r\\n]+",
  "word_segment": "[A-Za-z0-9_]",
  "tokens": {
    "comment": {
      "begin": "ちなみに、",
      "end": "(?=\\n)|\\Z"
    },
    "block": {
      "begin": "ほな",
      "begin.emit": " ほな",
      "sep": "",
      "sep.emit": " ",
      "end": "おしまい"
    },
    "assign": {
      "begin": "",
      "op": "を",
      "end": "に入れとく",
      "order": "value_first"
    },
    "append": {
      "begin": "",
      "sep": "を",
      "end": "に放り込む",
      "order": "value_first"
    },
    "inc": {
      "begin": "",
      "end": "を増やしたる"
    },
    "dec": {
      "begin": "",
      "end": "を減らしたる"
    },
    "if": {
      "begin": "もし",
      "then": "なんやったら",
      "end": ""
    },
    "ne": {
      "begin": "",
      "sep": "が",
      "end": "とちゃう"
    },
    "lt": {
      "begin": "",
      "sep": "が",
      "end": "よりちっさい"
    },
    "gt": {
      "begin": "",
      "sep": "が",
      "end": "よりでかい"
    },
    "le": {
      "begin": "",
      "sep": "が",
      "end": "以下"
    },
    "ge": {
      "begin": "",
      "sep": "が",
      "end": "以上"
    },
    "eq": {
      "begin": "",
      "sep": "が",
      "end": "と一緒"
    },
    "else": {
      "begin": "そやなかったら",
      "end": ""
    },
    "repeat": {
      "begin": "",
      "do": "回まわしたる",
      "end": ""
    },
    "break": "もうええ",
    "def": {
      "begin": "やり方",
      "begin.emit": "やり方 ",
      "name_end": "\\(",
      "end": ""
    },
    "params": {
      "begin": "",
      "end": "\\)ちゅうんは"
    },
    "param": {
      "sep": ",|(?=\\))",
      "sep.emit": ", "
    },
    "return": {
      "begin": "",
      "end": "を返したる"
    },
    "true": "ほんま",
    "false": "うそ",
    "none": "なんもなし",
    "list": {
      "begin": "\\[",
      "sep": ",|(?=\\])",
      "sep.emit": ", ",
      "end": "\\]"
    },
    "grouping": {
      "begin": "\\(",
      "end": "\\)"
    },
    "neg": {
      "begin": "-",
      "end": ""
    },
    "index": {
      "begin": "の\\(",
      "end": "\\)番目"
    },
    "funcapp": {
      "order": "args_first",
      "begin": "\\(",
      "name_end": "\\)を",
      "end": "にやらしたやつ",
      "arg_sep": ",|(?=\\))",
      "arg_sep.emit": ", "
    }
  },
  "stdlib": {
    "print": "しゃべる",
    "abs": "絶対値",
    "bool": "ほんまかいな",
    "chr": "字ぃ",
    "float": "小数",
    "int": "整数",
    "len": "長さ",
    "list": "並べ",
    "max": "いっちゃんでかい",
    "min": "いっちゃんちっさい",
    "ord": "字のコード",
    "range": "範囲",
    "round": "四捨五入",
    "sorted": "整列",
    "str": "文字列",
    "sum": "合計",
    "add": "足す",
    "sub": "引く",
    "mul": "掛ける",
    "div": "割る",
    "mod": "余り",
    "pow": "べき乗"
  },
  "lexical": {
    "letters": "[A-Za-z][A-Za-z0-9]*(?:_[A-Za-z0-9]+)*",
    "number": "[0-9]+(?:\\.[0-9]+)?",
    "string": "\"(?:[^\"\\\\\\n]|\\\\.)*\"|'(?:[^'\\\\\\n]|\\\\.)*'",
    "quote": {
      "begin": "_",
      "end": "_"
    },
    "characters": "[^_\\n]+"
  }
}
