{
  "name": "jalike",
  "description": "日本語風シンタックス。ブロックは『 』で囲む。名前は英数字とカタカナ、それ以外（漢字など）は「」で囲む。",
  "layout": "none",
  "toplevel": "bare",
  "space": "[ 　\\t\\r\\n]+",
  "tight_before": "』",
  "word_segment": "[A-Za-z0-9_]",
  "tokens": {
    "comment": { "begin": "※", "end": "(?=\\n)|\\Z" },
    "block": { "begin": "『", "sep": "", "sep.emit": " ", "end": "』" },
    "assign": { "begin": "", "op": "を", "end": "に代入", "order": "value_first" },
    "append": { "begin": "", "sep": "を", "end": "に追加", "order": "value_first" },
    "inc": { "begin": "", "end": "を増やす" },
    "dec": { "begin": "", "end": "を減らす" },
    "if": { "begin": "もし", "then": "なら", "end": "" },
    "ne": { "begin": "", "sep": "が", "end": "と等しくない" },
    "lt": { "begin": "", "sep": "が", "end": "より小さい" },
    "gt": { "begin": "", "sep": "が", "end": "より大きい" },
    "le": { "begin": "", "sep": "が", "end": "以下" },
    "ge": { "begin": "", "sep": "が", "end": "以上" },
    "eq": { "begin": "", "sep": "が", "end": "と等しい" },
    "else": { "begin": "そうでなければ", "end": "" },
    "repeat": { "begin": "", "do": "回くり返す", "end": "" },
    "break": "抜ける",
    "def": { "begin": "関数", "begin.emit": "関数 ", "name_end": "\\(", "end": "" },
    "params": { "begin": "", "end": "\\)とは" },
    "param": { "sep": ",|(?=\\))", "sep.emit": ", " },
    "return": { "begin": "", "end": "を返す" },
    "true": "真",
    "false": "偽",
    "none": "無",
    "list": { "begin": "\\[", "sep": ",|(?=\\])", "sep.emit": ", ", "end": "\\]" },
    "grouping": { "begin": "\\(", "end": "\\)" },
    "neg": { "begin": "-", "end": "" },
    "index": { "begin": "の\\(", "end": "\\)番目" },
    "funcapp": { "order": "args_first", "begin": "\\(", "name_end": "\\)における", "end": "の値", "arg_sep": ",|(?=\\))", "arg_sep.emit": ", " }
  },
  "stdlib": {
    "print": "表示",
    "abs": "絶対値",
    "bool": "ブール化",
    "chr": "文字化",
    "float": "小数化",
    "int": "整数化",
    "len": "長さ",
    "list": "配列化",
    "max": "最大",
    "min": "最小",
    "ord": "文字コード",
    "range": "範囲",
    "round": "四捨五入",
    "sorted": "整列",
    "str": "文字列化",
    "sum": "合計",
    "add": "足し算",
    "sub": "引き算",
    "mul": "掛け算",
    "div": "割り算",
    "mod": "余り",
    "pow": "べき乗"
  },
  "lexical": {
    "letters": "[A-Za-z][A-Za-z0-9]*(?:_[A-Za-z0-9]+)*",
    "number": "[0-9]+(?:\\.[0-9]+)?",
    "string": "\"(?:[^\"\\\\\\n]|\\\\.)*\"|'(?:[^'\\\\\\n]|\\\\.)*'",
    "quote": { "begin": "_", "end": "_" },
    "characters": "[^_\\n]+"
  }
}
