{
  "name": "latin",
  "description": "ラテン語版。ブロックはインデント。命令法で書く。`pone 1 in x`、`si x est minor quam 3:`、`itera 3 vices:`、`munus f(a, b):`。母音の長短記号は使わない。",
  "layout": "indent",
  "space": " +",
  "word_segment": "[A-Za-z0-9_]",
  "stdlib": {
    "print": "scribe",
    "abs": "absolutum",
    "bool": "veritas",
    "chr": "littera",
    "float": "fluens",
    "int": "integer",
    "len": "longitudo",
    "list": "series",
    "max": "maximum",
    "min": "minimum",
    "ord": "codex",
    "range": "spatium",
    "round": "rotunda",
    "sorted": "ordinata",
    "str": "chorda",
    "sum": "summa",
    "add": "adde",
    "sub": "subtrahe",
    "mul": "multiplica",
    "div": "divide",
    "mod": "reliquum",
    "pow": "potentia"
  },
  "tokens": {
    "comment": { "begin": "nota:", "end": "(?=\\n)|\\Z" },
    "block": { "begin": "@INDENT", "sep": "@NEWLINE", "end": "@DEDENT" },
    "assign": { "begin": "pone", "begin.emit": "pone ", "op": "in", "op.emit": " in ", "end": "", "order": "value_first" },
    "append": { "begin": "appone", "begin.emit": "appone ", "sep": "ad", "sep.emit": " ad ", "end": "", "order": "value_first" },
    "inc": { "begin": "auge", "begin.emit": "auge ", "end": "" },
    "dec": { "begin": "minue", "begin.emit": "minue ", "end": "" },
    "if": { "begin": "si", "begin.emit": "si ", "then": ":", "end": "" },
    "ne": { "begin": "", "sep": "non +est +aequalis", "sep.emit": " non est aequalis ", "end": "" },
    "lt": { "begin": "", "sep": "est +minor +quam", "sep.emit": " est minor quam ", "end": "" },
    "gt": { "begin": "", "sep": "est +maior +quam", "sep.emit": " est maior quam ", "end": "" },
    "le": { "begin": "", "sep": "est +non +maior +quam", "sep.emit": " est non maior quam ", "end": "" },
    "ge": { "begin": "", "sep": "est +non +minor +quam", "sep.emit": " est non minor quam ", "end": "" },
    "eq": { "begin": "", "sep": "est +aequalis", "sep.emit": " est aequalis ", "end": "" },
    "else": { "begin": "aliter *:", "end": "" },
    "repeat": { "begin": "itera", "begin.emit": "itera ", "do": "vices *:", "do.emit": " vices:", "end": "" },
    "break": "frange",
    "def": { "begin": "munus", "begin.emit": "munus ", "name_end": "\\(", "end": "" },
    "params": { "begin": "", "end": "\\) *:" },
    "param": { "sep": ",|(?=\\))", "sep.emit": ", " },
    "return": { "begin": "redde", "begin.emit": "redde ", "end": "" },
    "true": "verum",
    "false": "falsum",
    "none": "nihil",
    "list": { "begin": "\\[", "sep": ",|(?=\\])", "sep.emit": ", ", "end": "\\]" },
    "neg": { "begin": "-", "end": "" },
    "index": { "begin": "\\[", "end": "\\]" },
    "funcapp": { "begin": "", "name_end": "\\(", "end": "\\)", "arg_sep": ",|(?=\\))", "arg_sep.emit": ", " }
  },
  "lexical": {
    "letters": "[A-Za-z][A-Za-z0-9]*(?:_[A-Za-z0-9]+)*",
    "number": "[0-9]+(?:\\.[0-9]+)?",
    "string": "\"(?:[^\"\\\\\\n]|\\\\.)*\"|'(?:[^'\\\\\\n]|\\\\.)*'",
    "quote": { "begin": "_", "end": "_" },
    "characters": "[^_\\n]+"
  }
}
